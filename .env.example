# Copy to .env for local runs, or add each one in Vercel > Project > Settings > Environment Variables.
PROPERTYDATA_API_KEY=your-key-here           # leave out to run on demo data
APP_PASSWORD=choose-a-shared-password        # the password you and your partner sign in with
APP_SECRET=any-long-random-string            # signs login cookies
# DATABASE_URL is added for you when you connect a Neon database in Vercel (Storage tab).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
